# CUTEAFD starting config: Kimi K3, EXL3 K2 experts + K6 core, min (1x RTX + 6x Spark).
#
# Single-RTX qualification (#1178): use a ./wip.sh slot containing this path.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint first, then:
#
#   ./run.sh --config examples/configs/kimi-k3-exl3-k6-min.config --wip SLOT --dry-run
#   ./run.sh --config examples/configs/kimi-k3-exl3-k6-min.config --wip SLOT --restart
#
# One physical RTX owns the native K6 core; six Sparks hold the TP6 experts.
# The 110 GiB Spark allocation budget is required for this minimum layout.
# KV pool, context, onboarding and concurrency stay automatic. Text only, with
# the DFlash2 drafter.
#
# The reserve is pinned: the automatic 3 x 2752-row reserve needs 121.6 GB of
# Spark memory per rank at checkpoint loading, above this layout's 110 GiB
# budget, so shared admission refuses it. The qualified single-RTX shape is the
# 3 x 1024-row reserve (3072-row intake), which fits the budget.

MODEL_ID=wrldsuksgo2mars/Kimi-K3-EXL3-K2-Core-K6
MODEL_REVISION=1a28050d2954426a43a3db705e53ca120e5f2b47
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=lightseekorg/kimi-k3-dflash2
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=off
AUDIO=off

RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=6
SPARK_DEVICE_BUDGET_BYTES=118111600640
PREFILL_ROWS=1024

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_4_HOST=REPLACE-ME-spark-4
SPARK_5_HOST=REPLACE-ME-spark-5
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4
SPARK_4_LANE_A=192.0.2.5
SPARK_5_LANE_A=192.0.2.6

# Promoted release pair; --wip selects the qualified slot instead.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2

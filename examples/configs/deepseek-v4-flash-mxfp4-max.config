# CUTEAFD starting config: DeepSeek V4 Flash 0731, official MXFP4, max (2x RTX, no Sparks).
#
# All 43 expert layers fit on the RTX pair with a 2M-token pool.
# Download the checkpoint (and drafter) first, then:
#
#   ./run.sh --config examples/configs/deepseek-v4-flash-mxfp4-max.config --dry-run
#   ./run.sh --config examples/configs/deepseek-v4-flash-mxfp4-max.config --restart

MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-0731
MODEL_REVISION=9e165c30e2704aec5d9d593cce3eebd58bbef1cb
SPECULATOR=dspark
POOL_TOKENS=auto
EXPERT_BACKEND=local
VISION=auto
AUDIO=auto

RTX_GPUS=2
COORDINATOR_GPUS=0,1
SPARK_COUNT=0


# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2

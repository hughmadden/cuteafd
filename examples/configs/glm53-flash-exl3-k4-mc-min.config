# CUTEAFD starting config: GLM 5.3 Flash, EXL3 K4 MC, original BF16 core, min (1x RTX + 2x Spark).
#
# New checkpoint, no release card yet; use a matching WIP build.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint (and drafter)
# first, then:
#
#   ./run.sh --config examples/configs/glm53-flash-exl3-k4-mc-min.config --dry-run
#   ./run.sh --config examples/configs/glm53-flash-exl3-k4-mc-min.config --restart
#
# The original BF16 core is the default; optional views: k8-compact and k6-compact.
# fp8-compact is not supported for this checkpoint.

# Requires an engine with MC CORE_VIEW support (dev after #1778; first release after v5.0.0).
MODEL_ID=wrldsuksgo2mars/GLM-5.3-Flash-EXL3-K4-MC
MODEL_REVISION=91a8dbc9c12e790c65aa1a38c6aede6a3e23a77d
CORE_VIEW=original
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=auto
AUDIO=auto

RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=2

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2

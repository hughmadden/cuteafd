# MiniMax-M3.1-Flash: one RTX 5090 coordinator, Spark TP4.
# Native NVFP4 W4A4 experts and MXFP8 linears; no speculation.
# Add deployment-specific SPARK_HOSTS or SPARK_<rank>_HOST/LANE_A entries.
# Build a coordinator executable, then set CUTEAFD_PLAN_BIN for CPU admission:
#   ./run.sh --config examples/configs/minimax-m31-flash-nvfp4-5090-tp4.config --dry-run
# The dry run reads checkpoint headers without device probes or remote access.
# Set MODEL_ID to a local snapshot directory for header-only validation.
# Device correctness and runtime artifacts still need a separate hardware gate.

MODEL_ID=MiniMaxAI/MiniMax-M3.1-Flash
MODEL_REVISION=54e4e69dfc452b1e94a426c24a4fdeeaa8e3ad5e
EXPERT_BACKEND=spark
SPARK_COUNT=4
RTX_GPUS=1
COORDINATOR_GPU=0
COORDINATOR_GPU_BUDGET_GIB=31.8
RTX_EXPERT_LAYERS=0
SPECULATOR=off
KV_CACHE=fp8
EMBEDDING=gpu
VISION=auto
AUDIO=off
POOL_TOKENS=auto
CONCURRENCY=64
PREFILL_BATCH_TOKENS=4096
PREFIX_CACHE_ENTRIES=20
HOST_CACHE_BYTES=0

# Select images carrying serve-minimax and fp8-minimax-nvfp4a4, or use --wip.
COORDINATOR_DOCKER_INFERENCE=
SPARK_EXPERT_DOCKER_INFERENCE=

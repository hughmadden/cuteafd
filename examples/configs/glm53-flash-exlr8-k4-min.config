# CUTEAFD starting config: GLM 5.3 Flash, native EXLR8 K4, min (1x RTX + 1x Spark).
#
# Qualified native recipe (#1030) with automatic bundled vision (#1360).
# Replace the REPLACE-ME Spark host and 192.0.2.1 RoCE address with your own.
# Download the checkpoint and drafter first, then use a matching WIP build:
#
#   ./run.sh --config examples/configs/glm53-flash-exlr8-k4-min.config --dry-run
#   ./run.sh --config examples/configs/glm53-flash-exlr8-k4-min.config --wip SLOT --restart
#
# The planner chooses routed RTX layers and KV capacity; neither is pinned here.

MODEL_ID=kindlingai/glm-5.3-flash-exlr8-k2-k3-k4
MODEL_REVISION=867580abd28d142bb4c56218bb81a752b7dea988
SERVED_MODEL_ID=zai-org/GLM-5.3-Flash
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
EXLR8_MANIFEST=k4
EXLR8_PREFILL_ACTIVATIONS=a16
ATTENTION_PLACEMENT=auto
POOL_TOKENS=auto
EXPERT_BACKEND=spark
AUDIO=off

RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=1
SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_0_LANE_A=192.0.2.1

# The promoted release pair; native EXLR8 Flash requires a matching WIP build.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2

# MiniMax-M3.1-Flash: one RTX PRO 6000 coordinator, Spark TP3.
#
# Under qualification: serve it from a ./wip.sh slot built from a commit that
# has serve-minimax (native NVFP4 W4A4 experts and MXFP8 linears). Add your
# Spark hosts (SPARK_HOSTS, or SPARK_<rank>_HOST and SPARK_<rank>_LANE_A),
# download the checkpoint, then:
#
#   ./run.sh --config examples/configs/minimax-m31-flash-nvfp4-pro6000-tp3.config --wip SLOT --dry-run
#   ./run.sh --config examples/configs/minimax-m31-flash-nvfp4-pro6000-tp3.config --wip SLOT --restart
#
# Every other key takes the launcher's default: DFlash2 speculation, FP8 K/V,
# VISION=auto (the plan places the bundled tower), an automatic KV pool and the
# host prefix tier (HOST_CACHE_BYTES=auto, HOST_CACHE_STORE=on-evict).
# Prefill takes the plan's units (two waves of 4096 rows); PREFILL_ROWS and
# PREFILL_WAVES pin them.
# DFlash2 drafts with RadixArk/Minimax-M3.1-Flash-Dflash2, which cuteafd does not
# distribute: download it beside the release (see docs/models/minimax_m3.md).
# SPECULATOR=dspark uses the release's bundled drafter, SPECULATOR=off none.

MODEL_ID=MiniMaxAI/MiniMax-M3.1-Flash
MODEL_REVISION=54e4e69dfc452b1e94a426c24a4fdeeaa8e3ad5e
SPARK_COUNT=3
# Every routed layer stays on the Sparks.
RTX_EXPERT_LAYERS=0

# The promoted release pair (no release ships serve-minimax yet; --wip serves the slot).
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v2.0.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v2.0.0

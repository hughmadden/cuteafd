ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:26.05-py3
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV CARGO_HOME=/opt/cargo
ENV RUSTUP_HOME=/opt/rustup
ENV PATH=/opt/cargo/bin:${PATH}

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bash ca-certificates curl git git-lfs jq ripgrep pkg-config \
      build-essential clang cmake ninja-build nasm python3-venv \
      rdma-core ibverbs-providers libibverbs-dev perftest \
      openssh-client netcat-openbsd iproute2 pciutils && \
    rm -rf /var/lib/apt/lists/*

# Pinned toolchain: a release at least two weeks old, so builds do not move under us.
ARG RUST_TOOLCHAIN=1.98.1
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain ${RUST_TOOLCHAIN} && \
    rustup component add rustfmt

ENV UV_SYSTEM_PYTHON=1

RUN python3 -m pip install --no-cache-dir uv && \
    uv pip install --system --break-system-packages --no-cache \
      pytest \
      safetensors \
      huggingface-hub && \
    uv pip install --system --break-system-packages --no-cache \
      "nvidia-cutlass-dsl[cu13]==4.6.2" \
      "apache-tvm-ffi==0.1.12" \
      "cuda-tile==1.5.0" \
      "nvidia-cudnn-frontend==1.26.0" \
      "einops==0.8.2" \
      "ninja==1.13.0" \
      "nvidia-ml-py==13.610.43" \
      "pillow>=11,<13" \
      "tabulate==0.10.0" \
      "transformers==5.13.0" \
      "rich==15.0.0" && \
    uv pip install --system --break-system-packages --no-cache --no-deps \
      "flashinfer-python==0.6.14"

# Source/revision arguments deliberately follow the reusable toolchain and
# Python dependency layers so a new pinned fork commit does not reinstall them.
ARG CUTEAFD_ROLE=dev
ARG CUDA_ARCH=120
ARG TARGET_PLATFORM=linux/amd64
ARG CUTEAFD_SPARKINFER_COMMIT=unknown

ENV CUTEAFD_ROLE=${CUTEAFD_ROLE}
ENV CUTEAFD_CUDA_ARCH=${CUDA_ARCH}
ENV CUTEAFD_TARGET_PLATFORM=${TARGET_PLATFORM}
ENV CUTEAFD_SPARKINFER_COMMIT=${CUTEAFD_SPARKINFER_COMMIT}

LABEL io.cuteafd.sparkinfer.revision=${CUTEAFD_SPARKINFER_COMMIT}

COPY scripts/build/verify-sparkinfer-source.py /opt/cuteafd/scripts/build/verify-sparkinfer-source.py
COPY third_party/sparkinfer.lock.json /opt/cuteafd/third_party/sparkinfer.lock.json
COPY third_party/sparkinfer /opt/cuteafd/third_party/sparkinfer

RUN python3 /opt/cuteafd/scripts/build/verify-sparkinfer-source.py \
      --source /opt/cuteafd/third_party/sparkinfer \
      --lock /opt/cuteafd/third_party/sparkinfer.lock.json && \
    locked_revision="$(python3 /opt/cuteafd/scripts/build/verify-sparkinfer-source.py \
      --source /opt/cuteafd/third_party/sparkinfer \
      --lock /opt/cuteafd/third_party/sparkinfer.lock.json \
      --print-revision)" && \
    { [ "${CUTEAFD_SPARKINFER_COMMIT}" = unknown ] || \
      [ "${CUTEAFD_SPARKINFER_COMMIT}" = "$locked_revision" ]; } && \
    uv pip install --system --break-system-packages --no-cache --no-deps \
      --editable /opt/cuteafd/third_party/sparkinfer && \
    uv pip check && \
    python3 -c 'import importlib.metadata, pathlib, b12x; source = pathlib.Path("/opt/cuteafd/third_party/sparkinfer").resolve(); module = pathlib.Path(b12x.__file__).resolve(); assert module.is_relative_to(source), (module, source); print(importlib.metadata.version("b12x"), module)' && \
    python3 /opt/cuteafd/scripts/build/verify-sparkinfer-source.py \
      --source /opt/cuteafd/third_party/sparkinfer \
      --lock /opt/cuteafd/third_party/sparkinfer.lock.json \
      --require-no-python-cache

WORKDIR /workspace/cuteafd
ENV PYTHONPATH=/workspace/cuteafd/third_party/sparkinfer:/opt/cuteafd/third_party/sparkinfer:/workspace/cuteafd/python/reference/cuteafd_reference:/workspace/cuteafd/python/reference
COPY docker/entrypoint.sh /usr/local/bin/cuteafd-entrypoint
RUN chmod +x /usr/local/bin/cuteafd-entrypoint

ENTRYPOINT ["/usr/local/bin/cuteafd-entrypoint"]
CMD ["bash"]

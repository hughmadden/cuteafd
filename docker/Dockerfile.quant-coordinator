# Bind the build tag to the inspected base image ID before building.
# This packages the quantization/export stage; the end-to-end launcher is separate.
ARG BASE_IMAGE=cuteafd-quant-coordinator-base:6213ea40c796
FROM ${BASE_IMAGE}
ENV TORCH_ALLOW_TF32_CUBLAS_OVERRIDE=0
ENV TORCH_CUDA_ARCH_LIST=12.0
ENV PYTHONUNBUFFERED=1
ENV MAX_JOBS=8
COPY quantization/coordinator-overlay.lock /opt/cuteafd/coordinator-overlay.lock
RUN uv pip install --python /opt/glmrt/quant-venv/bin/python --no-deps -r /opt/cuteafd/coordinator-overlay.lock
# Install the pinned V4.1 Transformers source, including correct version metadata.
COPY third_party/transformers /opt/cuteafd/transformers
RUN uv pip install --python /opt/glmrt/quant-venv/bin/python --no-deps --no-build-isolation /opt/cuteafd/transformers
COPY third_party/gptqmodel/gptqmodel /opt/cuteafd/third_party/gptqmodel/gptqmodel
COPY third_party/gptqmodel/gptqmodel_ext /opt/cuteafd/third_party/gptqmodel/gptqmodel_ext
COPY quantization /opt/cuteafd/quantization
ENV PYTHONPATH=/opt/cuteafd/third_party/gptqmodel:/opt/cuteafd/quantization
WORKDIR /opt/cuteafd/quantization
RUN /opt/glmrt/quant-venv/bin/python -c "import importlib.metadata as m; import transformers, gptqmodel, tilelang; from gptqmodel.utils.v41_source import V41Source; from run_quantization import run; assert m.version('transformers') == transformers.__version__ == '5.18.0.dev0'; assert gptqmodel.__file__.startswith('/opt/cuteafd/'); print('coordinator imports passed')"
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/glmrt/quant-venv/bin/python", "/opt/cuteafd/quantization/run_quantization.py"]

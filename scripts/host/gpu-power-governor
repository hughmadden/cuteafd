#!/usr/bin/python3
"""Thermal power governor: holds each GPU below its throttle onset by setting its
power limit (NVML) from temperature headroom. Stdlib only. No writes with --check.

Why the power limit: this board has no firmware temperature target (only a power
limit), and a lower limit lowers voltage and clock together, the firmware's own
gentle, preventive throttle, for every workload on the card. Without it, sustained
prefill once heated a card until it fell off the PCIe bus (Xid 79).

Control, once per second per GPU:
  headroom   = NVML T.Limit margin (degrees before the GPU's maximum operating
               temperature; slowdown starts 2 degrees past it on RTX PRO 6000),
               smoothed with an EMA, plus its smoothed rate of change.
  predicted  = headroom + slope * lookahead (heating lowers it early).
  error      = target_headroom - predicted   (positive: too hot).
  limit      = ceiling - (kp * error + integral), integral of ki * error clamped to
               [0, ceiling - floor] (it bleeds back to 0 while cool).
  The limit falls at most down_w_per_s and rises at most up_w_per_s, stays in
  [floor, ceiling], and goes straight to the floor at or below hard_headroom.

Failsafe: a GPU whose reading fails or is missing drops to the floor until
readings return (then rises at up_w_per_s). On exit, a failed write, or a crash,
every GPU goes to safe_w (also ExecStopPost=--restore; the unit restarts always and
has a watchdog). The current limits and reasons are written to a state file that
the engine's throttle report includes.
"""
import argparse
import ctypes as C
import fcntl
import json
import logging
import math
import os
import signal
import socket
import threading
import time

LOG = logging.getLogger('gpu-power-governor')
STOP = threading.Event()
DEFAULT_CONFIG = '/etc/gpu-power-governor.json'
DEFAULTS = dict(
    floor_w=150, ceiling_w=325, safe_w=325,
    target_headroom_c=15.0, hard_headroom_c=8.0,
    kp_w_per_c=10.0, ki_w_per_c_s=1.0,
    ema_s=3.0, lookahead_s=10.0,
    down_w_per_s=40.0, up_w_per_s=4.0,
    period_s=1.0, step_w=5, reassert_s=30.0,
    state_file='/run/gpu-power-governor/state.json',
)


def read_config(path):
    with open(path) as stream:
        raw = json.load(stream)
    config = {**DEFAULTS, **raw}
    unknown = set(raw) - set(DEFAULTS) - {'hosts', 'gpu_uuids'}
    if unknown:
        raise ValueError(f'Unknown config keys: {sorted(unknown)}')
    validate(config)
    return config


def validate(config):
    uuids, hosts = config.get('gpu_uuids'), config.get('hosts')
    if not uuids or len(set(uuids)) != len(uuids) or any(not str(u).startswith('GPU-') for u in uuids):
        raise ValueError('gpu_uuids: expected unique GPU UUIDs')
    if not hosts or any(not isinstance(h, str) or not h for h in hosts):
        raise ValueError('hosts: expected the host names this governor may run on')
    if not 100 <= config['floor_w'] <= min(config['safe_w'], config['ceiling_w']):
        raise ValueError('Expected 100 <= floor_w <= safe_w and floor_w <= ceiling_w')
    if config['ceiling_w'] > 1000 or config['safe_w'] > 1000:
        raise ValueError('ceiling_w and safe_w must be at most 1000')
    if not 3 <= config['hard_headroom_c'] < config['target_headroom_c'] <= 40:
        raise ValueError('Expected 3 <= hard_headroom_c < target_headroom_c <= 40')
    for key in ('kp_w_per_c', 'ki_w_per_c_s', 'lookahead_s'):
        if not 0 <= config[key] <= 100:
            raise ValueError(f'{key} must be in [0, 100]')
    for key in ('ema_s', 'period_s', 'down_w_per_s', 'up_w_per_s', 'step_w', 'reassert_s'):
        if not 0 < config[key] <= 1000:
            raise ValueError(f'{key} must be in (0, 1000]')
    if config['up_w_per_s'] > config['down_w_per_s']:
        raise ValueError('up_w_per_s must not exceed down_w_per_s (lower fast, raise slowly)')


class Controller:
    """One GPU's control law; `update` takes a headroom reading (or None on failure)."""

    def __init__(self, config):
        self.c = config
        self.limit = float(config['ceiling_w'])
        self.integral = 0.0
        self.ema = None
        self.slope = 0.0
        self.reason = 'start'

    def _rate_limit(self, wanted, dt):
        down = self.c['down_w_per_s'] * dt
        up = self.c['up_w_per_s'] * dt
        return min(max(wanted, self.limit - down), self.limit + up)

    def update(self, headroom, dt):
        c = self.c
        floor, ceiling = float(c['floor_w']), float(c['ceiling_w'])
        if headroom is None or not math.isfinite(headroom):
            # Sensor failure: the safest place is the floor; keep the estimate for recovery.
            self.limit, self.reason = floor, 'sensor failure: floor'
            return self.limit
        alpha = 1.0 - math.exp(-dt / c['ema_s'])
        if self.ema is None:
            self.ema = headroom
        else:
            previous = self.ema
            self.ema += alpha * (headroom - self.ema)
            self.slope += alpha * ((self.ema - previous) / dt - self.slope)
        if headroom <= c['hard_headroom_c'] or self.ema <= c['hard_headroom_c']:
            self.integral = ceiling - floor
            self.limit, self.reason = floor, f'hard: headroom {headroom:.0f} C <= {c["hard_headroom_c"]:.0f} C'
            return self.limit
        predicted = self.ema + min(self.slope, 0.0) * c['lookahead_s']
        error = c['target_headroom_c'] - predicted
        self.integral = min(max(self.integral + c['ki_w_per_c_s'] * error * dt, 0.0), ceiling - floor)
        wanted = min(max(ceiling - c['kp_w_per_c'] * max(error, 0.0) - self.integral, floor), ceiling)
        self.limit = min(max(self._rate_limit(wanted, dt), floor), ceiling)
        if self.limit >= ceiling:
            self.reason = 'ceiling'
        else:
            self.reason = (f'headroom {self.ema:.1f} C (slope {self.slope:+.2f} C/s, predicted {predicted:.1f}) '
                           f'vs target {c["target_headroom_c"]:.0f} C')
        return self.limit

    def quantized(self):
        step = self.c['step_w']
        return int(max(self.c['floor_w'], min(self.c['ceiling_w'], step * math.floor(self.limit / step))))


class NVML:
    def __init__(self):
        self.lib = C.CDLL('libnvidia-ml.so.1')
        self.lib.nvmlErrorString.restype = C.c_char_p
        self.call('nvmlInit_v2')

    def call(self, name, *args):
        rc = getattr(self.lib, name)(*args)
        if rc:
            raise RuntimeError(f'{name}: {self.lib.nvmlErrorString(rc).decode()} ({rc})')

    def device(self, uuid):
        handle = C.c_void_p()
        self.call('nvmlDeviceGetHandleByUUID', uuid.encode(), C.byref(handle))
        return handle

    def number(self, name, *args):
        value = C.c_uint()
        self.call(name, *args, C.byref(value))
        return value.value

    def temperature(self, handle):
        value = self.number('nvmlDeviceGetTemperature', handle, 0)
        if not 0 < value < 125:
            raise RuntimeError(f'Invalid GPU temperature: {value}')
        return value

    def headroom(self, handle):
        class Margin(C.Structure):
            _fields_ = [('version', C.c_uint), ('margin', C.c_int)]
        margin = Margin(C.sizeof(Margin) | (1 << 24), 0)
        self.call('nvmlDeviceGetMarginTemperature', handle, C.byref(margin))
        if not -20 < margin.margin < 120:
            raise RuntimeError(f'Invalid T.Limit margin: {margin.margin}')
        return margin.margin

    def power_w(self, handle):
        return self.number('nvmlDeviceGetPowerUsage', handle) / 1000

    def limit_w(self, handle):
        return self.number('nvmlDeviceGetEnforcedPowerLimit', handle) / 1000

    def constraints_w(self, handle):
        low, high = C.c_uint(), C.c_uint()
        self.call('nvmlDeviceGetPowerManagementLimitConstraints', handle, C.byref(low), C.byref(high))
        return low.value / 1000, high.value / 1000

    def set_limit_w(self, handle, watts):
        self.call('nvmlDeviceSetPowerManagementLimit', handle, C.c_uint(int(watts) * 1000))

    def close(self):
        self.call('nvmlShutdown')


def notify(message):
    address = os.environ.get('NOTIFY_SOCKET')
    if address:
        if address.startswith('@'):
            address = '\0' + address[1:]
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
            sock.sendto(message.encode(), address)


def write_state(path, state):
    if not path:
        return
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    temporary = path + '.tmp'
    with open(temporary, 'w') as stream:
        json.dump(state, stream)
    os.chmod(temporary, 0o644)
    os.replace(temporary, path)


def restore_all(nvml, config):
    errors = []
    for uuid in config['gpu_uuids']:
        try:
            nvml.set_limit_w(nvml.device(uuid), config['safe_w'])
            LOG.info('Restored safe power limit: %s %sW', uuid, config['safe_w'])
        except Exception as exc:
            errors.append(str(exc))
            LOG.error('Cannot restore %s: %s', uuid, exc)
    return errors


def check_constraints(nvml, config, handles):
    for uuid, handle in handles:
        low, high = nvml.constraints_w(handle)
        if config['floor_w'] < low or max(config['ceiling_w'], config['safe_w']) > high:
            raise RuntimeError(f'{uuid}: limits {config["floor_w"]}..{config["ceiling_w"]} W (safe {config["safe_w"]}) '
                               f'outside the board range {low:.0f}..{high:.0f} W')


def run(nvml, config):
    handles = [(uuid, nvml.device(uuid)) for uuid in config['gpu_uuids']]
    check_constraints(nvml, config, handles)
    controllers = {uuid: Controller(config) for uuid, _ in handles}
    applied = {uuid: None for uuid, _ in handles}
    applied_at = {uuid: -math.inf for uuid, _ in handles}
    ready, last = False, time.monotonic()
    while not STOP.is_set():
        now = time.monotonic()
        dt = max(now - last, 1e-3) if ready else config['period_s']
        last = now
        gpus = []
        for uuid, handle in handles:
            controller = controllers[uuid]
            try:
                headroom = nvml.headroom(handle)
                temperature = nvml.temperature(handle)
                power = nvml.power_w(handle)
            except Exception as exc:
                LOG.error('%s reading failed: %s', uuid, exc)
                headroom = temperature = power = None
            controller.update(headroom, dt)
            target = controller.quantized()
            # Write on a change, and re-assert periodically (another tool may have set it).
            if target != applied[uuid] or now - applied_at[uuid] >= config['reassert_s']:
                nvml.set_limit_w(handle, target)  # A failed write ends the run: the finally restores.
                if target != applied[uuid]:
                    LOG.log(logging.WARNING if target < config['ceiling_w'] else logging.INFO,
                            '%s limit %s -> %s W (%s; core %s C, headroom %s C, power %s W)', uuid, applied[uuid],
                            target, controller.reason, temperature, headroom,
                            None if power is None else round(power))
                applied[uuid], applied_at[uuid] = target, now
            gpus.append(dict(uuid=uuid, limit_w=target, reason=controller.reason, temperature_c=temperature,
                             headroom_c=headroom, headroom_ema_c=controller.ema, slope_c_per_s=controller.slope,
                             power_w=power))
        throttled = [g for g in gpus if g['limit_w'] < config['ceiling_w']]
        write_state(config['state_file'], dict(
            updated=time.time(), host=socket.gethostname(), ceiling_w=config['ceiling_w'], floor_w=config['floor_w'],
            safe_w=config['safe_w'], target_headroom_c=config['target_headroom_c'],
            hard_headroom_c=config['hard_headroom_c'], gpus=gpus,
            reason='; '.join(f"{g['uuid'][:12]} {g['limit_w']} W: {g['reason']}" for g in throttled) or 'at ceiling'))
        if not ready:
            notify('READY=1')
            ready = True
        notify('WATCHDOG=1')
        STOP.wait(config['period_s'])


def control(nvml, config):
    try:
        run(nvml, config)
    finally:
        if restore_all(nvml, config):
            LOG.error('Incomplete restoration; systemd ExecStopPost will retry')
        try:
            write_state(config['state_file'], dict(updated=time.time(), host=socket.gethostname(), stopped=True,
                                                   reason=f'governor stopped: safe {config["safe_w"]} W'))
        except OSError:
            pass


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--config', default=DEFAULT_CONFIG)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--check', action='store_true', help='Read-only: readings, board ranges and the config')
    mode.add_argument('--restore', action='store_true', help='Set every configured GPU to safe_w')
    args = parser.parse_args()
    logging.basicConfig(level=logging.INFO, format='%(levelname)s %(message)s')
    config = read_config(args.config)
    host = socket.gethostname().split('.')[0]
    if host not in config['hosts']:
        raise SystemExit(f'gpu-power-governor: host {host} is not in the config hosts {config["hosts"]}')
    lock = None
    if not args.check:
        if os.geteuid() != 0:
            raise PermissionError('Power limit writes require root; --check is read-only')
        lock = open('/run/lock/gpu-power-governor.lock', 'w')
        # One controller at a time; a restore (ExecStopPost) waits for a dying one to let go.
        fcntl.flock(lock, fcntl.LOCK_EX if args.restore else fcntl.LOCK_EX | fcntl.LOCK_NB)
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: STOP.set())
    nvml = NVML()
    try:
        if args.check:
            for uuid in config['gpu_uuids']:
                handle = nvml.device(uuid)
                low, high = nvml.constraints_w(handle)
                print(json.dumps(dict(uuid=uuid, temperature_c=nvml.temperature(handle),
                                      headroom_c=nvml.headroom(handle), power_w=round(nvml.power_w(handle), 1),
                                      limit_w=nvml.limit_w(handle), board_range_w=[low, high],
                                      config=dict(floor_w=config['floor_w'], ceiling_w=config['ceiling_w'],
                                                  safe_w=config['safe_w'],
                                                  target_headroom_c=config['target_headroom_c'],
                                                  hard_headroom_c=config['hard_headroom_c']))))
            check_constraints(nvml, config, [(u, nvml.device(u)) for u in config['gpu_uuids']])
        elif args.restore:
            if restore_all(nvml, config):
                raise RuntimeError('One or more power limits could not be restored')
        else:
            control(nvml, config)
    finally:
        nvml.close()
        if lock:
            lock.close()


if __name__ == '__main__':
    main()

# Thermal power governor for raptor's RTX PRO 6000 cards; the control law and failsafes
# are in gpu-power-governor's docstring. Install: scripts/host/install-gpu-power-governor.sh.
[Unit]
Description=GPU thermal power governor (power limit from T.Limit headroom)
Wants=nvidia-persistenced.service
After=nvidia-persistenced.service nvidia-power-limit.service gpu-fan-curve.service
StartLimitIntervalSec=0

[Service]
Type=notify
ExecStart=/usr/local/sbin/gpu-power-governor
ExecStopPost=/usr/local/sbin/gpu-power-governor --restore
Restart=always
RestartSec=5
WatchdogSec=15
TimeoutStartSec=30
TimeoutStopSec=10
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RuntimeDirectory=gpu-power-governor
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/lock

[Install]
WantedBy=multi-user.target

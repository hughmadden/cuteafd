#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -f /.dockerenv ]]; then
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-/tmp/cuteafd-target}"
fi
exec "$repo_root/scripts/run-with-python-env.sh" \
  cargo run --manifest-path "$repo_root/rust/Cargo.toml" -p cuteafd-daemon --bin cuteafd -- "$@"

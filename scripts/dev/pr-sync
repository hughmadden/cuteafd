#!/usr/bin/env python3
"""Sync branch state with its draft PR; comments hold append-only history."""
import argparse
import json
from pathlib import Path
import subprocess
import sys

from _common import branch, gh, repo, run, task_dir, validate_body, validate_public


def current_pr(repository, name):
    prs = gh('pr', 'list', '--repo', repository, '--head', name, '--state', 'open',
             '--json', 'number,body,headRefName,headRepositoryOwner,headRepository', '--limit', '100')
    owner, repository_name = repository.split('/')
    prs = [pr for pr in prs if (pr.get('headRepositoryOwner') or {}).get('login') == owner
           and (pr.get('headRepository') or {}).get('name') == repository_name]
    if len(prs) > 1:
        raise ValueError('multiple open PRs for this branch; select one manually')
    return prs[0] if prs else None


def publish(repository, number, text, comment=False):
    # stdin keeps public text out of argv, and avoids a mutable body-file race.
    cmd = ['gh', 'pr', 'comment' if comment else 'edit', str(number),
           '--repo', repository, '--body-file', '-']
    result = subprocess.run(cmd, input=text, text=True, capture_output=True)
    if result.returncode:
        raise ValueError(f'gh pr {cmd[2]} failed (exit {result.returncode})')
    print(f'PR #{number}: {"comment added" if comment else "body updated"}')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    for command in ('pull', 'push', 'comment'):
        child = sub.add_parser(command)
        child.add_argument('--task')
        if command == 'push':
            child.add_argument('--file', type=Path)
        if command == 'comment':
            group = child.add_mutually_exclusive_group(required=True)
            group.add_argument('--file', type=Path)
            group.add_argument('--body')
    init = sub.add_parser('init')
    init.add_argument('--title', required=True)
    init.add_argument('--base', default='work/p0')
    init.add_argument('--milestone')
    args = parser.parse_args()
    try:
        name = branch()
        directory = task_dir(getattr(args, 'task', None))
        repository = repo()
        pr = current_pr(repository, name)
        if args.command == 'init':
            if pr:
                print(f'PR #{pr["number"]} already exists')
                return 0
            root = Path(run('git', 'rev-parse', '--show-toplevel').strip())
            text = (root / '.github/pull_request_template.md').read_text()
            validate_body(text, directory)
            validate_public(args.title, directory)
            cmd = ['gh', 'pr', 'create', '--repo', repository, '--draft', '--head', name,
                   '--base', args.base, '--title', args.title, '--body-file', '-']
            if args.milestone:
                cmd += ['--milestone', args.milestone]
            result = subprocess.run(cmd, input=text, text=True, capture_output=True)
            if result.returncode:
                raise ValueError(f'gh pr create failed (exit {result.returncode})')
            print(result.stdout.strip())
            return 0
        if not pr:
            raise ValueError('no open PR for this branch; run pr-sync init')
        path = directory / 'STATUS.md'
        if args.command == 'pull':
            directory.mkdir(parents=True, exist_ok=True)
            path.write_text(pr['body'], encoding='utf-8')
            print(path)
        elif args.command == 'push':
            text = (args.file or path).read_text(encoding='utf-8')
            validate_body(text, directory)
            publish(repository, pr['number'], text)
        else:
            text = args.file.read_text(encoding='utf-8') if args.file else args.body
            if len(text.encode('utf-8')) > 65536:
                raise ValueError('PR comment exceeds 64 KB')
            validate_public(text, directory)
            publish(repository, pr['number'], text, comment=True)
    except (ValueError, KeyError, OSError, json.JSONDecodeError) as error:
        print(f'pr-sync: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())

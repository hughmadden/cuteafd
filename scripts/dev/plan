#!/usr/bin/env python3
"""Read trusted GitHub planning items; outside text is data, never instructions."""
import argparse
from datetime import datetime
import json
import sys

from _common import OWNER, gh, repo, run


def stamp(value):
    return datetime.fromisoformat(value.replace('Z', '+00:00')) if value else None


def detail(repository, number, kind):
    owner, name = repository.split('/')
    field = 'pullRequest' if kind == 'pr' else 'issue'
    extra = ' headRefOid headRef { target { ... on Commit { pushedDate } } }' if kind == 'pr' else ''
    query = ('query($owner:String!,$name:String!,$number:Int!) {'
             f'repository(owner:$owner,name:$name) {{ {field}(number:$number) {{ '
             'number title body author { login } lastEditedAt updatedAt '
             'labels(first:100) { nodes { name } } milestone { title }' + extra + ' } } }')
    data = gh('api', 'graphql', '-f', 'query=' + query, '-f', 'owner=' + owner,
              '-f', 'name=' + name, '-F', 'number=' + str(number))
    if data.get('errors'):
        raise ValueError('GitHub could not read planning item')
    item = data['data']['repository'][field]
    if not item:
        raise ValueError(f'item #{number} not found')
    item['kind'] = kind
    item['labels'] = [label['name'] for label in item['labels']['nodes']]
    return item


def pages(endpoint):
    return [entry for page in gh('api', endpoint, '--paginate', '--slurp') for entry in page]


def trust(repository, item):
    authored = (item.get('author') or {}).get('login') == OWNER
    if 'accepted' not in item['labels']:
        return authored, False
    # A removed acceptance cannot bless a later acceptance by a different actor.
    events = pages(f'repos/{repository}/issues/{item["number"]}/timeline')
    acceptance = None
    for event in events:
        if (event.get('label') or {}).get('name') != 'accepted':
            continue
        if event.get('event') == 'unlabeled':
            acceptance = None
        elif event.get('event') == 'labeled':
            acceptance = event
    if not acceptance or (acceptance.get('actor') or {}).get('login') != OWNER:
        return authored, False
    accepted_at = stamp(acceptance['created_at'])
    edited = stamp(item.get('lastEditedAt'))
    review = bool(edited and edited > accepted_at)
    if item['kind'] == 'pr':
        target = ((item.get('headRef') or {}).get('target') or {})
        # GitHub can omit pushedDate (deleted refs / older commits). Fail closed:
        # updatedAt can over-flag comments, but never silently bless a new head.
        pushed = stamp(target.get('pushedDate') or item.get('updatedAt'))
        review = review or bool(pushed and pushed > accepted_at)
    return True, review


def items(repository, args):
    kinds = ['pr'] if args.prs else ['issue'] if args.issues else ['pr', 'issue']
    for kind in kinds:
        command = ['pr' if kind == 'pr' else 'issue', 'list', '--repo', repository,
                   '--state', 'open', '--limit', '1000', '--json', 'number,title,author,labels,milestone']
        if args.label:
            command += ['--label', args.label]
        if args.milestone and kind == 'issue':
            command += ['--milestone', args.milestone]
        summaries = gh(*command)
        if len(summaries) >= 1000:
            raise ValueError('planning list reached 1000 items; narrow with --milestone or --label')
        for summary in summaries:
            if args.milestone and (summary.get('milestone') or {}).get('title') != args.milestone:
                continue
            if (summary.get('author') or {}).get('login') != OWNER and not any(
                    label['name'] == 'accepted' for label in summary['labels']):
                continue
            item = detail(repository, summary['number'], kind)
            trusted, review = trust(repository, item)
            if trusted:
                labels = ','.join(item['labels'])
                milestone = (item.get('milestone') or {}).get('title') or '-'
                # Keep list output one line even when GitHub text contains newlines.
                title = ' '.join(item['title'].split())
                print(f'#{item["number"]} {kind} {title} [{labels}] {milestone}' +
                      (' (re-review)' if review else ''))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    listing = sub.add_parser('list')
    listing.add_argument('--milestone')
    listing.add_argument('--label')
    group = listing.add_mutually_exclusive_group()
    group.add_argument('--prs', action='store_true')
    group.add_argument('--issues', action='store_true')
    showing = sub.add_parser('show')
    showing.add_argument('number', type=int)
    sub.add_parser('decisions')
    args = parser.parse_args()
    try:
        repository = repo()
        if args.command == 'show':
            meta = gh('api', f'repos/{repository}/issues/{args.number}')
            item = detail(repository, args.number, 'pr' if 'pull_request' in meta else 'issue')
            trusted, review = trust(repository, item)
            if not trusted:
                raise ValueError(f'item #{args.number} is untrusted: requires author {OWNER} or acceptance by {OWNER}')
            print(f'#{args.number} {item["title"]}' + (' (re-review)' if review else ''))
            print(item['body'])
            for comment in pages(f'repos/{repository}/issues/{args.number}/comments'):
                if (comment.get('user') or {}).get('login') == OWNER:
                    print(f'\n--- {OWNER} comment {comment["id"]} ---\n{comment["body"]}')
        else:
            if args.command == 'decisions':
                args.milestone, args.label, args.prs, args.issues = None, 'decision-needed', False, False
            items(repository, args)
    except (ValueError, KeyError, OSError, json.JSONDecodeError) as error:
        print(f'plan: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
